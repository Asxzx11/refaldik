# ==============================================================================
# FIREBASE FIRESTORE CLOUD CONFIGURATION
# ==============================================================================
# Ganti nilai berikut dengan konfigurasi Firebase Anda agar tersambung ke Cloud Firestore.
# Jika dibiarkan kosong atau default, aplikasi akan otomatis berjalan dalam mode fallback offline (LocalStorage).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
